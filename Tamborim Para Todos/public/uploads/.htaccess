# Mesmo com validação de extensão/MIME no PHP, arquivos executáveis não podem
# ser acessados caso sejam colocados nesta pasta por engano.
<FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
